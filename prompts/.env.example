# Lumen environment configuration

# Provider selection: groq, auto, or gemini. Groq is the default.
LLM_PROVIDER=groq

# Multiple keys may be comma- or newline-separated.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Groq uses an OpenAI-compatible endpoint and offers a free tier.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Gemini model settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Images: gemini, huggingface, auto, or pollinations
IMAGE_PROVIDER=huggingface

# Hugging Face Inference Providers. Multiple tokens may be comma-separated.
# Qwen-Image is Apache 2.0; change this to another HF text-to-image model if
# you prefer. The default provider for this model is fal-ai.
HF_API_KEYS=
HF_IMAGE_MODEL=Qwen/Qwen-Image
HF_IMAGE_PROVIDER=fal-ai

# Pollinations remains the no-key final fallback.
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt
