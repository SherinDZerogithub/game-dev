# Lumen environment configuration

# Provider selection: groq, auto, or gemini. Groq is the default.
LLM_PROVIDER=groq

# Multiple keys may be comma- or newline-separated.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Groq uses an OpenAI-compatible endpoint and offers a free tier.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Gemini model settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Images: pollinations, gemini, or auto. Pollinations needs no API key.
IMAGE_PROVIDER=pollinations

# Pollinations image endpoint.
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt
